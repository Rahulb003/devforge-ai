# ---------------------------------------------------------------------------
# DevForge AI — environment template
#
# Copy to .env and fill in real values:      cp .env.example .env
# .env is gitignored and must never be committed.
#
# Values here are LOCAL DEVELOPMENT defaults only. They are deliberately weak
# and well-known. Never reuse any of them in staging or production — generate
# fresh secrets per environment and store them in a secret manager
# (Kubernetes Secrets backed by External Secrets / Sealed Secrets, AWS Secrets
# Manager, Vault, ...), not in a file.
# ---------------------------------------------------------------------------

# --- Active Spring profile -------------------------------------------------
# One of: local | dev | test | staging | prod
# There is intentionally NO default. A service started without this set, and
# without the secrets below, fails at startup rather than silently booting with
# development credentials.
SPRING_PROFILES_ACTIVE=local


# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devforge
POSTGRES_USER=devforge
# Local-only password. Generate a strong one per environment elsewhere.
POSTGRES_PASSWORD=devforge

# Full JDBC URL. Compose overrides the host to the service name "postgres".
DEVFORGE_DB_URL=jdbc:postgresql://localhost:5432/devforge


# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local; set it everywhere else.
REDIS_PASSWORD=


# --- JWT / session signing -------------------------------------------------
# HS256 requires at least 256 bits, i.e. 32+ bytes. The service validates this
# at startup and refuses to start on a short or missing key.
#
# Generate one:
#   openssl rand -base64 48
#
# Rotating this key invalidates every issued access and refresh token.
DEVFORGE_JWT_SIGNING_KEY=local-development-only-signing-key-change-me-0123456789abcdef
DEVFORGE_JWT_ISSUER=devforge-ai
DEVFORGE_JWT_ACCESS_TTL=15m
DEVFORGE_JWT_REFRESH_TTL=14d

# Refresh-cookie attributes. Secure MUST be true anywhere served over HTTPS;
# it is false locally only because plain-HTTP localhost cannot set secure cookies.
DEVFORGE_COOKIE_NAME=DEVFORGE_REFRESH_TOKEN
DEVFORGE_COOKIE_SECURE=false
DEVFORGE_COOKIE_SAME_SITE=Lax


# --- Outbound mail ---------------------------------------------------------
# Local development points at MailHog/Mailpit rather than a real relay, so
# verification and reset emails are captured instead of delivered.
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@devforge.ai
MAIL_STARTTLS_ENABLED=false
MAIL_AUTH_ENABLED=false

# Base URL used to build links inside emails.
DEVFORGE_APP_BASE_URL=http://localhost:4173


# --- OAuth2 providers ------------------------------------------------------
# Leave blank to disable OAuth login entirely. The auth service detects the
# absence of client registrations and starts with password login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# --- Service discovery / config --------------------------------------------
SPRING_CLOUD_CONFIG_URI=http://localhost:8888
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/


# --- RabbitMQ --------------------------------------------------------------
# Present only while the Kafka migration (see docs/PROGRESS.md, Phase 2) is
# pending. The keep-or-remove decision is still open.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq


# --- Observability ---------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Local-only. Change for any shared deployment.
GRAFANA_ADMIN_PASSWORD=admin


# --- Frontend --------------------------------------------------------------
# Compile-time only: Vite inlines VITE_* values into the bundle, so they are
# PUBLIC. Never put a secret behind a VITE_ prefix.
VITE_API_BASE_URL=/api/v1
