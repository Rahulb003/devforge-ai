<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.devforge.ai</groupId>
  <artifactId>devforge-ai-root</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <modules>
    <module>../common-library</module>
    <module>../common-security</module>
    <module>../common-events</module>
    <module>../config-server</module>
    <module>../discovery-server</module>
    <module>../api-gateway</module>
    <module>../services/auth-service</module>
    <module>../services/project-service</module>
    <module>../services/task-service</module>
    <module>../services/ai-service</module>
    <module>../services/git-service</module>
    <module>../services/review-service</module>
    <module>../services/documentation-service</module>
    <module>../services/chat-service</module>
    <module>../services/deployment-service</module>
    <module>../services/analytics-service</module>
    <module>../services/notification-service</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <spring.boot.version>3.4.0</spring.boot.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>2.7.0</springdoc.version>
    <jjwt.version>0.12.6</jjwt.version>
    <!-- The 2024.0.x train targets Spring Boot 3.4.x. -->
    <spring-cloud.version>2024.0.3</spring-cloud.version>
    <lombok.version>1.18.34</lombok.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    This reactor imports the Spring Boot BOM rather than inheriting from
    spring-boot-starter-parent, so plugin versions are NOT managed for us.
    Pinning them here keeps every module's build reproducible and removes the
    "plugin version is missing" warnings.
  -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
          <!--
            The repackage execution must be declared explicitly. It comes for free
            from spring-boot-starter-parent, but this reactor imports the BOM
            instead, so without this the build produces a plain library jar with no
            Main-Class and no bundled dependencies. `java -jar` on it fails with
            "no main manifest attribute", which is exactly what every container
            image does.
          -->
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <!--
              Retain parameter names in the bytecode. spring-boot-starter-parent
              sets this, but this reactor imports the BOM instead and so does not
              inherit it. Without it Spring cannot infer the name of a
              @PathVariable / @RequestParam argument and fails the request with
              "parameter name information not available via reflection".
            -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
