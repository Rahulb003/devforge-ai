# ---- Build output ----
target/
dist/
build/
out/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---- Node ----
# Belt and braces: tsconfig sets noEmit, but a stray tsc invocation must not
# leave compiled output beside the TypeScript sources.
frontend/src/**/*.js
frontend/src/**/*.jsx
node_modules/
.npm/
*.tsbuildinfo
coverage/
.vite/

# ---- Secrets and local environment ----
# .env.example IS tracked; real env files never are.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets.local.*
# The one exception: a throwaway test CA and broker keystore for KafkaTlsIntegrationTest, trusted by
# nothing else (see the README beside them). Named file by file so nothing else slips through.
!common-events/src/test/resources/kafka-tls/ca.pem
!common-events/src/test/resources/kafka-tls/broker.p12

# ---- IDE / editor ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Standalone-profile local database ----
# H2 files created by the standalone profile; never source.
data/
*.mv.db
*.trace.db

# ---- Playwright ----
playwright-report/
test-results/
blob-report/

# ---- Logs / temp ----
*.log
logs/
*.tmp
*.pid
*.seed

# ---- Test / tooling output ----
.surefire-*
**/surefire-reports/
**/failsafe-reports/
.gradle/
